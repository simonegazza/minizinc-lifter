<project xmlns="https://maven.apache.org/POM/4.0.0"
	xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>me.simonegazza</groupId>
	<artifactId>mzn-lift</artifactId>
	<version>0.1</version>
	<name>Parameter lifting parser</name>
	<description>MiniZinc to MiniZinc transpiler for parameter lifting</description>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<maven.compiler.release>25</maven.compiler.release>
	</properties>
	<dependencies>
		<!-- ANTLR -->
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
			<version>4.13.2</version>
		</dependency>
		<!-- Tests -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>6.1.0-M1</version>
			<scope>test</scope>
		</dependency>
		<!-- Command line options -->
		<dependency>
			<groupId>info.picocli</groupId>
			<artifactId>picocli</artifactId>
			<version>4.7.7</version>
		</dependency>
		<!--Json parsing for MiniZinc results -->
		<dependency>
		    <groupId>org.json</groupId>
		    <artifactId>json</artifactId>
		    <version>20260522</version>
		</dependency>
	</dependencies>
	<build>
		<finalName>lifter</finalName>
		<plugins>
			<!-- Run tests -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
				<configuration>
					<printSummary>true</printSummary>
					<reportFormat>plain</reportFormat>
				</configuration>
			</plugin>
			<!-- Create test jar -->
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-jar-plugin</artifactId>
			    <version>3.4.2</version>
			    <executions>
			        <execution>
			            <id>tests</id>
			            <goals>
			                <goal>test-jar</goal>
			            </goals>
			        </execution>
			    </executions>
			</plugin>
			<!-- Spotless - automatic with compile -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.43.0</version>
				<configuration>
					<java>
						<eclipse>
							<version>4.26</version>
							<file>${project.basedir}/code-style/code-style.xml</file>
						</eclipse>
						<removeUnusedImports />
						<trimTrailingWhitespace />
						<endWithNewline />
						<importOrder />
						<formatAnnotations />
					</java>
				</configuration>
				<executions>
					<execution>
						<id>format-on-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>apply</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Checkstyle -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>checkstyle-test</id>
						<phase>test</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
					<execution>
						<id>checkstyle-verify</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<configLocation>${project.basedir}/code-style/doc-style.xml</configLocation>
					<failOnViolation>true</failOnViolation>
					<consoleOutput>true</consoleOutput>
				</configuration>
			</plugin>
			<!-- exec:java -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<mainClass>me.simonegazza.lift.Main</mainClass>
				</configuration>
			</plugin>
			<!-- ANTLR4 - automatic with compile -->
			<plugin>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-maven-plugin</artifactId>
				<version>4.13.2</version>
				<executions>
		        <!-- Execution for MiniZinc -->
		        <execution>
		            <id>antlr-minizinc</id>
		            <goals><goal>antlr4</goal></goals>
		            <configuration>
		                <sourceDirectory>${project.basedir}/grammars</sourceDirectory>
		                <includes><include>MiniZinc.g4</include></includes>
		                <outputDirectory>${project.basedir}/src/main/java/me/simonegazza/antlr/minizinc</outputDirectory>
		                <visitor>true</visitor>
		                <arguments>
		                    <argument>-package</argument>
		                    <argument>me.simonegazza.antlr.minizinc</argument>
		                </arguments>
		            </configuration>
		        </execution>
		    </executions>
			</plugin>
			<!-- Creates the jars -->
			<plugin>
			    <groupId>org.apache.maven.plugins</groupId>
			    <artifactId>maven-assembly-plugin</artifactId>
			    <version>3.7.1</version>
			    <executions>
			        <!-- lifter.jar -->
			        <execution>
			            <id>lifter</id>
			            <phase>package</phase>
			            <goals><goal>single</goal></goals>
			            <configuration>
			                <appendAssemblyId>false</appendAssemblyId>
			                <finalName>lifter</finalName>
			                <archive>
			                    <manifest><mainClass>me.simonegazza.lift.Main</mainClass></manifest>
			                </archive>
			                <descriptorRefs>
			                	<descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			        <!-- test-run.jar -->
			        <execution>
			            <id>test-run</id>
			            <phase>package</phase>
			            <goals><goal>single</goal></goals>
			            <configuration>
			                <appendAssemblyId>false</appendAssemblyId>
			                <finalName>test-run</finalName>
			                <archive>
			                    <manifest>
			                        <mainClass>me.simonegazza.recovery.Runner</mainClass>
			                    </manifest>
			                </archive>
			                <descriptorRefs>
			                    <descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			        <!-- test-randomizer.jar -->
			        <execution>
			            <id>test-randomizer</id>
			            <phase>package</phase>
			            <goals><goal>single</goal></goals>
			            <configuration>
			                <appendAssemblyId>false</appendAssemblyId>
			                <finalName>test-randomizer</finalName>
			                <archive>
			                    <manifest>
			                        <mainClass>me.simonegazza.recovery.Randomizer</mainClass>
			                    </manifest>
			                </archive>
			                <descriptorRefs>
			                    <descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			        <!-- iingl-generator -->
			        <execution>
			            <id>iingl-generator</id>
			            <phase>package</phase>
			            <goals><goal>single</goal></goals>
			            <configuration>
			                <appendAssemblyId>false</appendAssemblyId>
			                <finalName>iingl-generator</finalName>
			                <archive>
			                    <manifest>
			                        <mainClass>me.simonegazza.learning.Generator</mainClass>
			                    </manifest>
			                </archive>
			                <descriptorRefs>
			                    <descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			        <!-- iingl-runner -->
			        <execution>
			            <id>iingl-runner</id>
			            <phase>package</phase>
			            <goals><goal>single</goal></goals>
			            <configuration>
			                <appendAssemblyId>false</appendAssemblyId>
			                <finalName>iingl-runner</finalName>
			                <archive>
			                    <manifest>
			                        <mainClass>me.simonegazza.learning.Runner</mainClass>
			                    </manifest>
			                </archive>
			                <descriptorRefs>
			                    <descriptorRef>jar-with-dependencies</descriptorRef>
			                </descriptorRefs>
			            </configuration>
			        </execution>
			    </executions>
			</plugin>
		</plugins>
	</build>
</project>