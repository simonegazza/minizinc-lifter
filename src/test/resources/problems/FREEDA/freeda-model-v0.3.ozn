output let {array [int] of string: X_INTRODUCED_1272_ = [if fix(node[c]) > 0 then "Component "++format(c)++" deployed in flavour "++format([set2array(Flavs)[i] | i in Flav[c] where D[Idx(c,i),node[c]] > 0][1])++" on node "++format(set2array(Nodes)[node[c]])++".\n" else "Component "++format(c)++" not deployed.\n" endif | c in Comps]++["Objective value: "++format(obj)++"\n\tTotal cost: "++format(totCost)++"\n\tTotal carb: "++format(totCarb)++""]} in (["\"output\": {","\"default\": ",showJSON(concat(X_INTRODUCED_1272_)),", \"raw\": ",showJSON(concat(X_INTRODUCED_1272_)),"}, \"sections\": [\"default\", \"raw\"]"]);
